#!/bin/bash
set -euo pipefail

readonly CACHE_FILE_INSTALLED=/tmp/eix-installed
readonly CACHE_FILE_ALL=/tmp/eix-all

check_requirements() {
  local missing=0
  for cmd in eix equery fzf-tmux; do
    if ! command -v "$cmd" &> /dev/null; then
      echo "Error: Required command '$cmd' not found" >&2
      missing=1
    fi
  done
  if [ $missing -eq 1 ]; then
    exit 1
  fi
}

update_cache() {
  local cache_type=${1}
  local silent=${2:-0}

  local cache_file
  local equery_cmd
  local error_msg

  equery_cmd=(equery list)
  
  if [ "$cache_type" = "all" ]; then
    cache_file="$CACHE_FILE_ALL"
    equery_cmd+=(-o -p)
    error_msg="Error: Failed to update package cache"
  else
    cache_file="$CACHE_FILE_INSTALLED"
    error_msg="Error: Failed to update installed package cache"
  fi

  # shellcheck disable=SC2016
  if [ "$silent" -eq 1 ]; then
    "${equery_cmd[@]}" -F '$cp' '*' 2>/dev/null | uniq | sort > "$cache_file" || {
      echo "$error_msg" >&2
      return 1
    }
  else
    "${equery_cmd[@]}" -F '$cp' '*' 2>/dev/null | uniq | tee >(sort > "$cache_file") || {
      echo "$error_msg" >&2
      return 1
    }
  fi
}

get_packages() {
  if [ ! -f "$CACHE_FILE" ]; then
    update_cache "$cache_type" 0
  else
    cat "$CACHE_FILE"
  fi
}

show_help() {
  printf "usage: %s [options] [query]\n\n" "$0"
  printf "Options:\n"
  printf "  -f, --refresh         Refresh cache\n"
  printf "  -F, --refresh-silent  Refresh cache and do not output anything (useful\n"
  printf "                        for updating the cache in a hook or cron job)\n"
  printf "  -i, --installed       Query only installed packages (Default)\n"
  printf "  -a, --all             Query all packages\n"
  printf "  -n, --no-preview      Don't show preview window (Default)\n"
  printf "  -p, --preview         Show preview window with package details\n"
  printf "  -E, --no-eix          Don't run eix on selection, just print package name\n"
  printf "  -h, --help            Show this help\n"
  printf "\n"
  printf "Arguments:\n"
  printf "  query                 Prefilled search query for fzf (optional)\n"
  printf "\n"
}

set_cache_mode() {
  local mode=$1
  cache_type="$mode"
  if [ "$mode" = "all" ]; then
    CACHE_FILE="$CACHE_FILE_ALL"
    eix_command=(eix)
  else
    CACHE_FILE="$CACHE_FILE_INSTALLED"
    eix_command=(eix -I)
  fi
}

check_requirements

refresh=0
silent_refresh=0
set_cache_mode "installed"
preview=0
run_eix=1

process_option() {
  case "$1" in
    f|refresh)
      refresh=1
      ;;
    F|refresh-silent)
      refresh=1
      silent_refresh=1
      ;;
    i|installed)
      set_cache_mode "installed"
      ;;
    a|all)
      set_cache_mode "all"
      ;;
    p|preview)
      preview=1
      ;;
    n|no-preview)
      preview=0
      ;;
    E|no-eix)
      run_eix=0
      ;;
    h|help)
      show_help
      exit 0
      ;;
    *)
      echo "Error: Unknown option: $1" >&2
      show_help
      exit 1
      ;;
  esac
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --*)
      # Long option
      process_option "${1#--}"
      shift
      ;;
    -*)
      # Short option(s) - could be bundled
      opt="${1#-}"
      shift
      if [[ ${#opt} -eq 1 ]]; then
        # Single short option
        process_option "$opt"
      else
        # Bundled short options
        for (( i=0; i<${#opt}; i++ )); do
          process_option "${opt:$i:1}"
        done
      fi
      ;;
    *)
      break
      ;;
  esac
done

preview_command=""
if [ "$preview" -eq 1 ]; then
  preview_command="${eix_command[*]} -F {}"
fi

if [ "$silent_refresh" -eq 1 ]; then
  if [ "$refresh" -eq 1 ]; then
    update_cache "$cache_type" 1
  fi
  exit 0
fi

if [ "$refresh" -eq 1 ]; then
  rm -f "$CACHE_FILE"
fi

fzf_args=("+s")
if [ -n "$preview_command" ]; then
  fzf_args+=("--preview" "$preview_command")
fi

if [ $# -gt 0 ]; then
  fzf_args+=("-1" "-q" "$1")
fi

package=$(get_packages | fzf-tmux "${fzf_args[@]}")

if [ -n "${package}" ]; then
  if [ "$run_eix" -eq 1 ]; then
    "${eix_command[@]}" -e "${package}"
  else
    echo "${package}"
  fi
fi
